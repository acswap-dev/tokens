{
  "schemaVersion": 1,
  "id": "bsc-testnet-basic-vault-v1",
  "category": "vault",
  "address": "0x634B67fB12c2dE2Ba81dCccb320D4cf76BfDdBa1",
  "builtin": true,
  "name": "BasicVault 基础金库",
  "version": "2.0.0",
  "description": "管理交易税及持币份额，支持营销、销毁、流动性回流和持币分红。税收兑换为募集币后收取 20% 平台份额，其余按项目配置分配；奖励币可与募集币相同，异种奖励币需有效兑换路径。每个项目创建独立金库实例，创建时固定绑定。 可独立搭配 Mint 或 Pump 募集模型，奖励收款地址由金库单独配置。",
  "adapter": "basic-vault-model-v1",
  "features": [
    "交易税分配",
    "营销与销毁",
    "流动性回流并锁定 LP",
    "持币分红",
    "独立项目金库"
  ],
  "registrations": [],
  "configuration": {
    "version": 2,
    "contract": {
      "apiVersion": 1,
      "configSchema": "0xfb3fcf2c86b25c6a69f16e707f06ea48f6a256ad884a3eb14b8e85b736e14726",
      "marker": 2
    },
    "fields": [
      {
        "key": "marketing",
        "label": "营销",
        "ui": "slider",
        "default": "0",
        "unit": "%",
        "required": true,
        "decimals": 2,
        "min": "0",
        "max": "100",
        "step": "0.01"
      },
      {
        "key": "burn",
        "label": "销毁",
        "ui": "slider",
        "default": "0",
        "unit": "%",
        "required": true,
        "decimals": 2,
        "min": "0",
        "max": "100",
        "step": "0.01"
      },
      {
        "key": "liquidity",
        "label": "自动加池",
        "ui": "slider",
        "default": "0",
        "unit": "%",
        "required": true,
        "decimals": 2,
        "min": "0",
        "max": "100",
        "step": "0.01"
      },
      {
        "key": "dividend",
        "label": "持币分红",
        "ui": "slider",
        "default": "100",
        "unit": "%",
        "required": true,
        "decimals": 2,
        "min": "0",
        "max": "100",
        "step": "0.01"
      },
      {
        "key": "marketingRecipient",
        "label": "营销收款地址",
        "ui": "address",
        "default": "",
        "hint": "留空使用创建者。",
        "required": false
      },
      {
        "key": "customReward",
        "label": "使用其他分红币",
        "ui": "switch",
        "default": "false",
        "hint": "关闭时使用募集币；其他分红币需要有效的兑换路径。",
        "required": true
      },
      {
        "key": "rewardToken",
        "label": "分红币合约地址",
        "ui": "token",
        "default": "",
        "required": true,
        "when": {
          "op": "eq",
          "args": [
            {
              "field": "customReward"
            },
            "true"
          ]
        }
      },
      {
        "key": "rewardPath",
        "label": "完整兑换路径",
        "ui": "array",
        "default": "",
        "hint": "用空格分隔：募集币 → 中间币（可选）→ 分红币；不同币种必填，同币种可留空。",
        "required": false,
        "when": {
          "op": "eq",
          "args": [
            {
              "field": "customReward"
            },
            "true"
          ]
        }
      },
      {
        "key": "minHold",
        "label": "参与分红的最低持仓",
        "ui": "number",
        "default": "1",
        "unit": "token",
        "required": true,
        "decimals": "tokenDecimals",
        "min": "0"
      },
      {
        "key": "minDistribution",
        "label": "最低领取金额",
        "ui": "number",
        "default": "0",
        "unit": "reward",
        "required": true,
        "decimals": "rewardDecimals",
        "min": "0"
      },
      {
        "key": "claimInterval",
        "label": "领取间隔",
        "ui": "slider",
        "default": "1800",
        "unit": "秒",
        "required": true,
        "decimals": 0,
        "min": "0",
        "max": "31536000",
        "step": "60"
      },
      {
        "key": "slippage",
        "label": "自动处理滑点上限",
        "ui": "slider",
        "default": "3",
        "unit": "%",
        "hint": "用于税收兑换与补池，不是前期参与滑点。",
        "required": true,
        "decimals": 2,
        "min": "0.01",
        "max": "99.99",
        "step": "0.01"
      },
      {
        "key": "swapThreshold",
        "label": "自动处理门槛",
        "ui": "number",
        "default": "100",
        "unit": "token",
        "required": true,
        "decimals": "tokenDecimals",
        "min": "0"
      },
      {
        "key": "maxSwapAmount",
        "label": "单次最大处理量",
        "ui": "number",
        "default": "1000",
        "unit": "token",
        "required": true,
        "decimals": "tokenDecimals",
        "min": "0"
      },
      {
        "key": "vaultProjectRecipient",
        "label": "无持币份额时的奖励收款地址",
        "ui": "address",
        "default": "",
        "hint": "留空使用创建者。该地址由金库独立配置，不跟随募集模型切换。",
        "required": false
      }
    ],
    "sections": [
      {
        "title": "税收分配",
        "description": "四项合计必须为 100%。这是税币处理比例，不是募集本金分配。",
        "fields": [
          "marketing",
          "burn",
          "liquidity",
          "dividend",
          "marketingRecipient"
        ]
      },
      {
        "title": "分红配置",
        "fields": [
          "customReward",
          "rewardToken",
          "rewardPath",
          "minHold",
          "minDistribution",
          "claimInterval"
        ]
      },
      {
        "title": "自动处理",
        "fields": [
          "slippage",
          "swapThreshold",
          "maxSwapAmount"
        ]
      },
      {
        "title": "金库独立收款",
        "fields": [
          "vaultProjectRecipient"
        ]
      }
    ],
    "summary": [
      "marketing",
      "burn",
      "liquidity",
      "dividend"
    ],
    "rules": [
      {
        "field": "dividend",
        "message": "四项税收分配合计必须为 100%",
        "assert": {
          "op": "eq",
          "args": [
            {
              "op": "add",
              "args": [
                {
                  "op": "units",
                  "args": [
                    {
                      "field": "marketing"
                    },
                    2
                  ]
                },
                {
                  "op": "units",
                  "args": [
                    {
                      "field": "burn"
                    },
                    2
                  ]
                },
                {
                  "op": "units",
                  "args": [
                    {
                      "field": "liquidity"
                    },
                    2
                  ]
                },
                {
                  "op": "units",
                  "args": [
                    {
                      "field": "dividend"
                    },
                    2
                  ]
                }
              ]
            },
            10000
          ]
        }
      },
      {
        "field": "claimInterval",
        "message": "领取间隔须在 0～31536000 秒内",
        "assert": {
          "op": "and",
          "args": [
            {
              "op": "gte",
              "args": [
                {
                  "op": "integer",
                  "args": [
                    {
                      "field": "claimInterval"
                    }
                  ]
                },
                0
              ]
            },
            {
              "op": "lte",
              "args": [
                {
                  "op": "integer",
                  "args": [
                    {
                      "field": "claimInterval"
                    }
                  ]
                },
                31536000
              ]
            }
          ]
        }
      },
      {
        "field": "rewardPath",
        "message": "兑换路径须为 2～5 个不重复地址，以募集币开始、奖励币结束",
        "assert": {
          "op": "and",
          "args": [
            {
              "op": "gte",
              "args": [
                {
                  "op": "length",
                  "args": [
                    {
                      "op": "addresses",
                      "args": [
