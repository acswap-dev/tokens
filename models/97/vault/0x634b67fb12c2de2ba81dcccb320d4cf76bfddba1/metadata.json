                  ]
                },
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "field": "customReward"
                        },
                        "true"
                      ]
                    },
                    {
                      "op": "address",
                      "args": [
                        {
                          "field": "rewardToken"
                        }
                      ]
                    },
                    {
                      "context": "baseToken"
                    }
                  ]
                }
              ]
            },
            {
              "op": "unique",
              "args": [
                {
                  "op": "addresses",
                  "args": [
                    {
                      "field": "rewardPath"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "when": {
          "op": "not",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "field": "customReward"
                        },
                        "true"
                      ]
                    },
                    {
                      "op": "address",
                      "args": [
                        {
                          "field": "rewardToken"
                        }
                      ]
                    },
                    {
                      "context": "baseToken"
                    }
                  ]
                },
                {
                  "context": "baseToken"
                }
              ]
