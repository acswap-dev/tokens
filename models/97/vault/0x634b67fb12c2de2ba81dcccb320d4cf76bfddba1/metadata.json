                {
                  "op": "units",
                  "args": [
                    {
                      "field": "maxSwapAmount"
                    },
                    {
                      "context": "tokenDecimals"
                    }
                  ]
                },
                "5192296858534827628530496329220095"
              ]
            }
          ]
        }
