      {
        "key": "targetPrice",
        "label": "计划发射价",
        "ui": "number",
        "default": "0.00000001",
        "unit": "price",
        "hint": "参与数量倍率与计划加池数量的基准价；额外注入募集币可能提高实际首池价。",
        "required": true,
        "decimals": 18,
        "min": "0"
      },
      {
        "key": "lpRatio",
        "label": "募集资金加池比例",
        "ui": "slider",
        "default": "50",
        "unit": "%",
        "hint": "最高 95%；另扣除 5% 成功平台费，其余归项目方。",
        "required": true,
        "decimals": 2,
        "min": "0.01",
        "max": "95",
        "step": "0.01"
      },
      {
        "key": "projectRecipient",
        "label": "项目方收款地址",
        "ui": "address",
        "default": "",
        "hint": "留空使用当前钱包，接收成功后的剩余募集款。",
        "required": false
      },
      {
        "key": "startWeight",
        "label": "初始数量倍率",
        "ui": "slider",
        "default": "1.5",
        "unit": "倍",
        "hint": "1.5 倍表示同样本金获得计划发射价基准数量的 1.5 倍代币。",
        "required": true,
        "decimals": 18,
        "min": "1",
        "max": "100",
        "step": "0.01"
      },
      {
        "key": "endWeight",
        "label": "最终数量倍率",
        "ui": "slider",
        "default": "1",
        "unit": "倍",
        "hint": "随有效募集进度线性变化，跨区间按积分计算；初始不得小于最终，最终至少 1 倍。",
        "required": true,
        "decimals": 18,
        "min": "1",
        "max": "100",
        "step": "0.01"
      },
      {
        "key": "allowExit",
        "label": "允许中途退出",
        "ui": "switch",
        "default": "true",
        "hint": "开启后不设截止时间，退出退回 90% 本金；关闭则使用限时软顶规则。",
        "required": true
      },
      {
        "key": "deadline",
        "label": "募集截止时间",
        "ui": "datetime",
        "default": "",
        "required": true,
        "when": {
          "op": "eq",
          "args": [
            {
              "field": "allowExit"
            },
            "false"
          ]
        }
      },
      {
        "key": "softCap",
        "label": "最低上线完成度",
        "ui": "slider",
        "default": "50",
        "unit": "%",
        "required": true,
        "when": {
          "op": "eq",
          "args": [
            {
              "field": "allowExit"
            },
            "false"
          ]
